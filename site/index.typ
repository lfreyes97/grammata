// Landing de Grammata, en dos idiomas. Se compila a HTML con:  site/build.sh
// El idioma llega por `--input lang=en|es`; el inglés va en la raíz y el español en es/.
#let lang = sys.inputs.at("lang", default: "en")
#let tr(es, en) = if lang == "es" { es } else { en }
#let base = tr("../", "") // los recursos compartidos viven en la raíz

#set document(title: tr("Grammata, un editor de Typst para escritorio", "Grammata, a desktop editor for Typst"))
#set text(lang: lang)

#let el(tag, ..args) = html.elem(tag, attrs: args.named(), args.pos().join())
#let enlace(href, cuerpo, clase: none) = html.elem(
  "a", attrs: if clase == none { (href: href) } else { (href: href, class: clase) }, cuerpo)
// Siglas en versalitas.
#let sg(t, ..) = html.elem("abbr", t)
#let pdf = sg("PDF", "Portable Document Format")
// El nombre de Typst como logotipo (el tema le da forma, como el de LaTeX).
#let typst = html.elem("span", attrs: (class: "typst"))[Typst]

#let repo = "https://github.com/lfreyes97/grammata"
#let sitio = "https://lfreyes97.github.io/grammata/"

#html.elem("meta", attrs: (name: "description", content: tr(
  "Editor de escritorio para Typst, escrito en Rust, con el compilador embebido y vista previa en tiempo real.",
  "Desktop editor for Typst, written in Rust, with the compiler embedded and live preview.")))
#html.elem("meta", attrs: (name: "color-scheme", content: "light dark"))
#html.elem("link", attrs: (rel: "stylesheet", href: base + "style.css"))
#html.elem("script", attrs: (src: base + "tema.js", defer: ""))[]
#html.elem("link", attrs: (rel: "icon", href: base + "img/grammata-32.png"))
#html.elem("link", attrs: (rel: "alternate", hreflang: "en", href: sitio))
#html.elem("link", attrs: (rel: "alternate", hreflang: "es", href: sitio + "es/"))
#html.elem("link", attrs: (rel: "alternate", hreflang: "x-default", href: sitio))

#el("header", class: "portada")[
  #el("a", class: "marca", href: repo)[
    #html.elem("picture")[
      #html.elem("source", attrs: (media: "(prefers-color-scheme: dark)", srcset: base + "img/logo-horizontal-oscuro.svg"))
      #html.elem("img", attrs: (src: base + "img/logo-horizontal-claro.svg", alt: "Grammata", width: "193", height: "56"))
    ]
  ]
  #html.elem("a", attrs: (
    class: "idioma", href: tr("../", "es/"), hreflang: tr("en", "es"), lang: tr("en", "es")),
    tr("English", "Español"))
  #html.elem("h1")[
    #el("span", tr([Editor de #typst con vista previa en tiempo real], [A #typst editor with real-time preview]))
    #el("span", tr([y paneles reorganizables.], [and rearrangeable panels.]))
  ]
  #el("p", class: "entrada", tr(
    [Aplicación de escritorio hecha en Rust, con el compilador de #enlace("https://typst.app")[#typst] embebido.],
    [Desktop app written in Rust, with the #enlace("https://typst.app")[#typst] compiler embedded.]))
  #el("div", class: "acciones")[
    #enlace(repo + "/releases/latest", clase: "boton", tr[Descargar la última versión][Download the latest release])
  ]
]

#let captura(nombre, alt, perezosa: true) = html.elem("picture")[
  #html.elem("source", attrs: (media: "(prefers-color-scheme: dark)", srcset: base + "img/" + nombre + "-oscuro.webp"))
  #html.elem("img", attrs: (
    src: base + "img/" + nombre + "-claro.webp", alt: alt, width: "1400", height: "875", decoding: "async",
    loading: if perezosa { "lazy" } else { "eager" }))
]

#let lamina(n, titulo, nota, ..args) = el("figure", class: "captura ancha")[
  #captura(..args)
  #html.elem("figcaption")[#html.elem("b")[#tr("Lámina", "Plate") #n] #html.elem("span")[#titulo. #nota]]
]

#let seccion(titulo, id: none, clase: none, cuerpo) = {
  let attrs = (class: if clase == none { "seccion" } else { "seccion " + clase })
  if id != none { attrs.insert("id", id) }
  html.elem("section", attrs: attrs)[
    #html.elem("h2", titulo)
    #el("div", class: "cuerpo", cuerpo)
  ]
}

#el("main")[
  #seccion(tr("Qué hace", "What it does"))[
    #el("ul", class: "lista")[
      #html.elem("li", tr(
        [Vista previa del #pdf que genera el compilador. Con errores, conserva la última versión que compiló.],
        [#pdf preview generated by the compiler. With errors, it keeps the last version that compiled.]))
      #html.elem("li", tr(
        [Resaltado con el analizador oficial de #typst, autocompletado, búsqueda, ir a línea y esquema del documento.],
        [Highlighting with the official #typst parser, autocompletion, search, go to line and a document outline.]))
      #html.elem("li", tr(
        [Panel de problemas con salto a la línea, también en archivos incluidos.],
        [Problems panel that jumps to the line, also in included files.]))
      #html.elem("li", tr(
        [136 símbolos y 22 estructuras (`frac`, `sqrt`, `mat`, `cases`…) con buscador; borrador con vista previa propia para ecuaciones.],
        [136 symbols and 22 structures (`frac`, `sqrt`, `mat`, `cases`…) with search; a scratchpad with its own preview for equations.]))
      #html.elem("li", tr(
        [Snippets de serie y propios, con marcadores para la selección y el cursor.],
        [Built-in and custom snippets, with placeholders for the selection and the cursor.]))
      #html.elem("li", tr(
        [Plugins: carpetas con un `plugin.toml` que aportan paquetes de #typst con formulario, fuentes, snippets y temas, o llaman a programas externos (Pandoc para Markdown). Esos programas requieren tu permiso, que se pierde si cambia su línea de comandos.],
        [Plugins: folders with a `plugin.toml` that provide #typst packages with a form, fonts, snippets and themes, or call external programs (Pandoc for Markdown). Those programs need your permission, which is lost if their command line changes.]))
      #html.elem("li", tr(
        [Pestañas y paneles que se arrastran y se dividen. La vista previa solo rasteriza las páginas visibles.],
        [Tabs and panels you can drag and split. The preview only rasterizes the visible pages.]))
    ]
  ]

  #let fila(..celdas) = html.elem("tr", celdas.pos().enumerate().map(((i, c)) =>
    if i == 0 { html.elem("th", attrs: (scope: "row"), c) } else { html.elem("td", c) }).join())

  #seccion(tr("Descargas", "Downloads"), id: "descargas")[
    #el("p", tr(
      [Paquetes en la #enlace(repo + "/releases/latest")[última versión]. Arch y Nix, desde el repositorio.],
      [Packages in the #enlace(repo + "/releases/latest")[latest release]. Arch and Nix, from the repository.]))
    #el("div", class: "tabla")[
      #html.elem("table")[
        #html.elem("thead")[#html.elem("tr")[
          #html.elem("th", attrs: (scope: "col"), tr[Sistema][System])
          #html.elem("th", attrs: (scope: "col"), tr[Qué instalar][What to install])
          #html.elem("th", attrs: (scope: "col"), tr[Estado][Status])
        ]]
        #html.elem("tbody")[
          #fila[Linux][
            #tr([`.deb`, AppImage o `.tar.gz` (dentro, `./install.sh`)], [`.deb`, AppImage or `.tar.gz` (inside, `./install.sh`)])
          ][#tr[Probado en GNOME con Wayland.][Tested on GNOME with Wayland.]]
          #fila[Arch Linux][
            #tr([`PKGBUILD` en `packaging/arch` (`makepkg -si`)], [`PKGBUILD` in `packaging/arch` (`makepkg -si`)])
          ][#tr[Probado.][Tested.]]
          #fila[Windows][
            #tr([`.zip` con `grammata.exe`], [`.zip` with `grammata.exe`])
          ][#tr([Se compila en #sg("CI"), pero nadie lo ha probado a mano.], [Built in #sg("CI"), but nobody has tested it by hand.])]
          #fila[Nix][`nix run github:lfreyes97/grammata`][#tr[El flake todavía no se ha probado.][The flake hasn't been tested yet.]]
          #fila[macOS][#tr[No hay paquete.][No package.]][#tr[No se ha probado.][Not tested.]]
        ]
      ]
    ]
    #el("p", class: "aviso", tr(
      [Grammata aún no lee argumentos de línea de comandos: no abre archivos pasados como argumento ni desde el gestor de archivos.],
      [Grammata doesn't read command-line arguments yet: it doesn't open files passed as an argument or from the file manager.]))
  ]

  #seccion(tr("Capturas de pantalla", "Screenshots"), clase: "capturas")[
    #lamina("01", tr("Ensayo", "Essay"),
      tr("Código a la izquierda y, a la derecha, la página con título, epígrafe y capitular ornamentada.",
         "Code on the left and, on the right, the page with title, epigraph and ornamental drop cap."),
      "ensayo",
      tr("Grammata con un ensayo abierto: el código a la izquierda y, a la derecha, la página con título, epígrafe y capitular ornamentada",
         "Grammata with an essay open: the code on the left and, on the right, the page with title, epigraph and ornamental drop cap"),
      perezosa: false)
    #lamina("02", tr("Cartel", "Poster"),
      tr("Una cita en cursiva sobre fondo verde oscuro.", "An italic quotation on a dark green background."),
      "cartel-epigrafe",
      tr("Grammata con un cartel abierto: una cita en cursiva sobre fondo verde oscuro",
         "Grammata with a poster open: an italic quotation on a dark green background"))
  ]

  #seccion(tr("Licencia", "License"))[
    #el("p", tr(
      [#sg("GNU") #sg("GPL") v3 o posterior. Usa #typst (Apache-2.0) y otras dependencias compatibles.
       Errores e ideas, en los #enlace(repo + "/issues")[issues]\; el código, en #enlace(repo)[GitHub].],
      [#sg("GNU") #sg("GPL") v3 or later. Uses #typst (Apache-2.0) and other compatible dependencies.
       Bugs and ideas go in the #enlace(repo + "/issues")[issues]\; the code is on #enlace(repo)[GitHub].]))
  ]
]

#el("footer")[
  #el("p", tr([Grammata viene del griego γράμματα, «letras».], [Grammata comes from the Greek γράμματα, “letters”.]))
  #el("p", tr(
    [«#typst» es una marca de Typst GmbH. Grammata es un proyecto independiente, sin relación con esa empresa.],
    [“#typst” is a trademark of Typst GmbH. Grammata is an independent project, not affiliated with that company.]))
]
